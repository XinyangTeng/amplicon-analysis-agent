# Web 服务（本机 8000 被占用时可改为 8001）
WEB_PORT=8001
PUBLIC_BASE_URL=
PRIVACY_CONTACT=

# 中国网络下的容器构建镜像；如某个镜像不可用，可单独替换。
UBUNTU_MIRROR=https://mirrors.aliyun.com/ubuntu
CRAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/CRAN/
# 官方镜像列表中的 Posit 节点保留历史版本；可留空使用同一默认值。
BIOCONDUCTOR_MIRROR=https://bioconductor.posit.co
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 邀请制账户。建议仅在首次内测启动时设置一个高强度邀请码；
# 也可启动后执行 scripts/manage_access.py 单独生成邀请码。
AMPLICON_BOOTSTRAP_INVITE=
AMPLICON_BOOTSTRAP_INVITE_USES=10
AMPLICON_BOOTSTRAP_INVITE_DAYS=30
AMPLICON_SESSION_DAYS=7
# 正式 HTTPS 部署必须改为 true
AMPLICON_COOKIE_SECURE=false

# 上传、个人存储、并发和自动删除
AMPLICON_MAX_UPLOAD_MB=200
AMPLICON_MAX_TOTAL_UPLOAD_MB=500
AMPLICON_MAX_USER_STORAGE_MB=2048
AMPLICON_MAX_ACTIVE_JOBS=1
AMPLICON_RETENTION_DAYS=7
AMPLICON_ANALYSIS_TIMEOUT_SECONDS=3600
AMPLICON_R_TIMEOUT_SECONDS=1800
AMPLICON_WORKER_MEMORY_MB=6144

# 共享模型额度；用户也可以在网页填写自己的 API Key。
AMPLICON_MONTHLY_MODEL_QUOTA=10
MODEL_PROVIDER=
MODEL_PROTOCOL=
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=180
# metadata 对话只发送压缩摘要；数值越小，token 和隐私暴露越少。
AI_METADATA_MAX_ROWS=40
AI_METADATA_MAX_COLUMNS=15
# 可选：逗号分隔的模型接口域名白名单
MODEL_ALLOWED_HOSTS=
